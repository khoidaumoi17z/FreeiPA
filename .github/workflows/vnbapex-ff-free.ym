name: Build VNBAPEX FF FREE IPA
on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - VNBAPEX-FF-FREE.zip
      - VNBAPEX-FF-FREE/**
      - .github/workflows/vnbapex-ff-free.yml
permissions:
  contents: read
jobs:
  build:
    runs-on: macos-15
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      - name: Unpack source
        run: |
          set -euo pipefail
          if [[ ! -d VNBAPEX-FF-FREE ]]; then
            unzip -q VNBAPEX-FF-FREE.zip
          fi
      - name: Generate Xcode project
        run: |
          set -euo pipefail
          if ! command -v xcodegen >/dev/null; then
            brew install xcodegen
          fi
          xcodebuild -version
          cd VNBAPEX-FF-FREE
          xcodegen generate
      - name: Build unsigned device app
        run: |
          set -euo pipefail
          mkdir -p output
          xcodebuild -project VNBAPEX-FF-FREE/VNBAPEXFFFREE.xcodeproj \
            -scheme VNBAPEXFFFREE -configuration Release \
            -sdk iphoneos -destination 'generic/platform=iOS' \
            -derivedDataPath "$GITHUB_WORKSPACE/build" \
            CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO \
            build 2>&1 | tee output/build.log
      - name: Package IPA and verify
        run: |
          set -euo pipefail
          mkdir -p output/Payload
          cp -R build/Build/Products/Release-iphoneos/VNBAPEXFFFREE.app output/Payload/
          python3 VNBAPEX-FF-FREE/verify_app.py output/Payload/VNBAPEXFFFREE.app
          cd output
          zip -qr VNBAPEX-FF-FREE-unsigned.ipa Payload
          shasum -a 256 VNBAPEX-FF-FREE-unsigned.ipa > SHA256.txt
          rm -rf Payload
      - uses: actions/upload-artifact@v4
        with:
          name: VNBAPEX-FF-FREE-IPA
          path: |
            output/VNBAPEX-FF-FREE-unsigned.ipa
            output/SHA256.txt
          if-no-files-found: error
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: VNBAPEX-FF-FREE-Build-Logs
          path: output/build.log
          if-no-files-found: ignore
